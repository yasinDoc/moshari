{
  "goal": "weekly-briefing",
  "proofs": [
    {
      "criterion": "1",
      "kind": "target",
      "command": "{python} .claude/goals/weekly-briefing-verify.py logic",
      "expect_regex": "(?m)^PASS logic",
      "timeout": 900,
      "catches": "wrong stock or bed source, Hospital vs Dispatch routing mixed up, city filter ignored, hard-coded demo numbers, wrong plural or sentence branch, missing 'All wards supplied', network or streamlit import in the logic module"
    },
    {
      "criterion": "2",
      "kind": "target",
      "command": "{python} .claude/goals/weekly-briefing-verify.py pdf",
      "expect_regex": "(?m)^PASS pdf",
      "timeout": 900,
      "catches": "two pages, not A4, compressed or image-only text, non-deterministic bytes, static/copied PDF for every setting, missing decision sentence, section, top ward or transfer"
    },
    {
      "criterion": "3",
      "kind": "target",
      "command": "{python} .claude/goals/weekly-briefing-verify.py page",
      "expect_regex": "(?m)^PASS page",
      "timeout": 900,
      "catches": "Overview strip missing, stale or at other settings; Overview cards removed; page not in app.py; page crashing on an empty week; button serving HTML, a deferred callable or a different scenario; wrong file name; sliders not driving the PDF"
    },
    {
      "criterion": "4",
      "kind": "target",
      "command": "{python} .claude/goals/weekly-briefing-verify.py tests && {python} -m pytest tests/test_briefing.py tests/test_briefing_page.py -o addopts=\"\" -q -rs",
      "expect_regex": "(?m)^(?:1[3-9]|[2-9]\\d|\\d{3,}) passed in ",
      "timeout": 900,
      "catches": "missing, too few, hollow (no assert) or skipped tests; tests not touching the PDF, alert_text, build, the transfer week or the empty week; page tests without AppTest; assert True or constant asserts; required words only in comments"
    },
    {
      "criterion": "5",
      "kind": "invariant",
      "command": "{python} -m pytest -o addopts=\"\" -q",
      "timeout": 1200
    },
    {
      "criterion": "6",
      "kind": "target",
      "command": "{python} .claude/goals/weekly-briefing-verify.py git",
      "expect_regex": "(?m)^PASS git",
      "catches": "work uncommitted, commit without prefix or not authored by Ananya, files outside SCOPE (existing tests, engines, other pages), app.py or requirements.txt changed beyond one added line, Overview rewritten"
    }
  ],
  "counters": [
    {
      "name": "tests",
      "command": "{python} -m pytest --co -q -o addopts=\"\"",
      "regex": "(\\d+) tests? collected",
      "rule": "no_decrease"
    }
  ],
